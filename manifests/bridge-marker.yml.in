apiVersion: apps/v1
kind: DaemonSet
metadata:
  name: bridge-marker
  namespace: ${NAMESPACE}
  labels:
    tier: node
    app: bridge-marker
spec:
  selector:
    matchLabels:
      name: bridge-marker
  updateStrategy:
    type: RollingUpdate
    rollingUpdate:
      maxUnavailable: 10%
  template:
    metadata:
      labels:
        tier: node
        app: bridge-marker
        name: bridge-marker
      annotations:
        description: Bridge marker exposes network bridges available on nodes as node resources
    spec:
      serviceAccountName: bridge-marker
      hostNetwork: true
      nodeSelector:
        kubernetes.io/os: linux
      tolerations:
      - key: node-role.kubernetes.io/master
        operator: Exists
        effect: NoSchedule
      priorityClassName: system-node-critical
      containers:
      - name: bridge-marker
        image: ${BRIDGE_MARKER_IMAGE_REPO}/${BRIDGE_MARKER_IMAGE_NAME}:${BRIDGE_MARKER_IMAGE_VERSION}
        imagePullPolicy: ${BRIDGE_MARKER_IMAGE_PULL_POLICY}
        args:
          - -logtostderr=true
          - -node-name
          - $(NODE_NAME)
          - -health-probe-port
          - "${HEALTH_PROBE_PORT}"
        resources:
          requests:
            cpu: "10m"
            memory: "15Mi"
        env:
          - name: NODE_NAME
            valueFrom:
              fieldRef:
                fieldPath: spec.nodeName
        ports:
        - name: healthport
          containerPort: ${HEALTH_PROBE_PORT}
          protocol: TCP
        terminationMessagePolicy: FallbackToLogsOnError
        readinessProbe:
          httpGet:
            path: /healthz
            port: healthport
          initialDelaySeconds: 5
          periodSeconds: 10
        livenessProbe:
          httpGet:
            path: /healthz
            port: healthport
          initialDelaySeconds: 10
          periodSeconds: 20
---
kind: ClusterRole
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: bridge-marker-cr
rules:
- apiGroups:
  - ""
  resources:
  - nodes
  verbs:
  - get
- apiGroups:
  - ""
  resources:
  - nodes/status
  verbs:
  - patch
---
kind: ClusterRoleBinding
apiVersion: rbac.authorization.k8s.io/v1
metadata:
  name: bridge-marker-crb
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: bridge-marker-cr
subjects:
- kind: ServiceAccount
  name: bridge-marker
  namespace: ${NAMESPACE}
---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: bridge-marker
  namespace: ${NAMESPACE}
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicy
metadata:
  name: bridge-marker-node-restriction
spec:
  failurePolicy: Fail
  matchConstraints:
    resourceRules:
    - apiGroups:
      - ""
      apiVersions:
      - v1
      operations:
      - UPDATE
      resources:
      - nodes/status
  matchConditions:
  - name: is-bridge-marker-sa
    expression: "request.userInfo.username == 'system:serviceaccount:${NAMESPACE}:bridge-marker'"
  variables:
  - name: requestFromOwnNode
    expression: "has(request.userInfo.extra) && ('authentication.kubernetes.io/node-name' in request.userInfo.extra) && object.metadata.name == request.userInfo.extra['authentication.kubernetes.io/node-name'][0]"
  - name: oldNonBridgeCapacity
    expression: 'oldObject.status.capacity.filter(k, !k.startsWith("bridge.network.kubevirt.io/"))'
  - name: newNonBridgeCapacity
    expression: 'object.status.capacity.filter(k, !k.startsWith("bridge.network.kubevirt.io/"))'
  validations:
  - expression: "variables.requestFromOwnNode"
    message: "this user cannot modify this node"
    reason: Forbidden
  - expression: 'has(object.status.capacity) && has(oldObject.status.capacity) && size(variables.newNonBridgeCapacity) == size(variables.oldNonBridgeCapacity) && variables.newNonBridgeCapacity.all(k, k in variables.oldNonBridgeCapacity && object.status.capacity[k] == oldObject.status.capacity[k])'
    message: "this user can only add, remove, or update status.capacity keys under bridge.network.kubevirt.io/"
    reason: Forbidden
---
apiVersion: admissionregistration.k8s.io/v1
kind: ValidatingAdmissionPolicyBinding
metadata:
  name: bridge-marker-node-restriction
spec:
  policyName: bridge-marker-node-restriction
  validationActions:
  - Deny
